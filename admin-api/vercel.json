{
  "buildCommand": "NODE_OPTIONS=\"--max_old_space_size=4096\" npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max_old_space_size=4096",
      "NEXT_FORCE_WEBPACK": "true"
    }
  },
  "functions": {
    "src/app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_OPTIONS": "--max_old_space_size=4096",
    "NEXT_FORCE_WEBPACK": "true"
  }
}