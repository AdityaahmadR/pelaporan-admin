      "regex": "^/api/edukasi/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/edukasi/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/notifikasi/[userID]",
